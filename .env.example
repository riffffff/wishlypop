# =============================================
# WISHLY — Environment Variables (Copy ke .env)
# =============================================

# ---- URL Aplikasi (WAJIB diisi saat production) ----
# Domain utama Wishly kamu
NEXT_PUBLIC_APP_URL=https://wishlypop.com

# ---- Lemon Squeezy (Payment Gateway) ----
# Dapatkan di: https://app.lemonsqueezy.com/settings/api
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
# ID variant produk e-card Wishly ($4) di dashboard Lemon Squeezy
LEMON_SQUEEZY_VARIANT_ID=
# Buat di: https://app.lemonsqueezy.com/settings/webhooks
LEMON_SQUEEZY_WEBHOOK_SECRET=

# ---- Resend (Email Delivery) ----
# Dapatkan di: https://resend.com/api-keys
RESEND_API_KEY=

# ---- Database (auto dari docker-compose, ganti jika perlu) ----
# SQLite (default, volume terpisah)
DATABASE_URL=file:./data/wishly.db
